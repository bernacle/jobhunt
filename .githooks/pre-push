#!/usr/bin/env bash
# Runs the local quality gate (scripts/check.sh) before every push, so CI
# minutes are spent confirming work that already passes, not finding typos.
# Adds --cloud when JOBHUNT_TEST_DATABASE_URL is set.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git push --no-verify

set -euo pipefail

# stdin has one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A push that only deletes refs (every local sha all zeros) has nothing to check.
zero='^0+$'
only_deletes=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [[ ! $local_sha =~ $zero ]]; then
        only_deletes=false
    fi
done
if $only_deletes; then
    exit 0
fi

args=()
if [[ -n "${JOBHUNT_TEST_DATABASE_URL:-}" ]]; then
    args+=(--cloud)
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running ./scripts/check.sh ${args[*]:-}" >&2
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    # check.sh sees the working tree; the push only sends commits.
    echo "pre-push: note: uncommitted changes are checked too, but not pushed." >&2
fi
if ./scripts/check.sh ${args[@]+"${args[@]}"} </dev/null >&2; then
    echo "pre-push: all checks passed, pushing." >&2
else
    status=$?
    echo "pre-push: checks failed, push aborted." >&2
    echo "pre-push: in an emergency, 'git push --no-verify' skips this hook." >&2
    exit "$status"
fi
