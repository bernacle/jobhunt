{
 "about": "BRU-330 job-description annotations for the 50 judged BRU-325 postings: what each job IS (function, engineering shape, specialization depth and specialties, seniority, customer-facing), for scoring the semantic job classifier. Separate from, and never used to change, the BRU-325 Fit judgments in bru325-2026-10-01.json. Not read by production code. See docs/job-function-semantic-classifier-experiment.md.",
 "annotator": "one annotator (Claude), from the bounded job text the classifier is sent, written before any classifier output existed",
 "conventions": {
  "lists": "every field lists the acceptable answers; an answer agrees when it is one of them",
  "shapes": "scored only when the job is a software engineering IC in both the annotation and the answer; the answer's shapes must be a non-empty subset",
  "specialties": "the answer must tag at least one of specialties_required (when any) and nothing outside specialties_required + specialties_allowed",
  "depth_for_non_ic": "depth is barely meaningful for non-engineering work; general, specialized and unclear are all accepted, and depth agreement is also reported for IC jobs only",
  "seniority": "a title with no level accepts unclear, plus the level the scope clearly implies",
  "critical": "bad_function, management, deep_specialist, strong_yes (Fit strong_yes in BRU-325)"
 },
