# The web app's configuration (see README.md, "Configuration"). Copy this
# file to .env.local, which Next.js loads and git ignores, and fill it in.
# Never commit real values.
#
# The web app needs a running JobHunt API (`jobhunt server`); the API, its
# workers and their secrets are configured separately, through their own
# environment (docs/cloud.md).

# Required. Where the server reaches the API.
JOBHUNT_API_URL=http://127.0.0.1:8080

# Required. Encrypts the session cookie: 32 or more random characters,
# e.g. the output of `openssl rand -base64 32`. Left empty on purpose.
JOBHUNT_WEB_SESSION_SECRET=

# Optional. This app's URL (OAuth redirect: <url>/auth/callback).
# Default: http://localhost:3000
# JOBHUNT_WEB_URL=http://localhost:3000

# Optional. The API's public URL, shown in the MCP connection instructions.
# Default: JOBHUNT_API_URL
# JOBHUNT_API_PUBLIC_URL=http://127.0.0.1:8080

# `oidc` (default) or `dev`. `dev` signs in by name and only works against
# an API running in development auth mode (JOBHUNT_AUTH_MODE=dev), which
# the API refuses in production.
JOBHUNT_WEB_AUTH_MODE=dev

# Required when JOBHUNT_WEB_AUTH_MODE is `oidc`: the web app's OAuth client
# at your identity provider. The secret is only for a confidential client.
# JOBHUNT_WEB_OIDC_CLIENT_ID=
# JOBHUNT_WEB_OIDC_CLIENT_SECRET=
# Default: openid profile email offline_access
# JOBHUNT_WEB_OIDC_SCOPES=openid profile email offline_access
